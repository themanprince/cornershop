BASE_URL=http://localhost:8000          # production: https://yourapp.onrender.com (no trailing slash)
SESSION_SECRET=change-me-long-random    # python -c "import secrets; print(secrets.token_urlsafe(48))"
ENV=development                          # production enables https_only cookies

DATABASE_URL=postgresql://...            # Supabase POOLER connection string (Connect -> Transaction pooler)

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...            # server-side only, never sent to templates
SUPABASE_BUCKET=ShoppingWebsiteBucket    # must be a PUBLIC bucket

GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

ADMIN_EMAILS=admin1@example.com,admin2@example.com

PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

BREVO_API_KEY=xkeysib-...
MAIL_FROM_EMAIL=you@example.com          # must be a verified sender in Brevo
MAIL_FROM_NAME=Cornershop
